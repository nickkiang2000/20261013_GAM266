{
  "manifest_version": 3,
  "name": "YouTube Knowledge & Investment Immersion - Phase 0.2",
  "version": "0.2.0",
  "description": "Capture visible YouTube captions, import user-provided transcripts, normalize segments, and export structured JSON locally.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open YouTube Knowledge side panel"
  }
}