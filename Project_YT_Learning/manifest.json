{
  "manifest_version": 3,
  "name": "YouTube Knowledge & Investment Immersion",
  "version": "0.10.0",
  "description": "Captures verified YouTube transcripts and lazily resolves local knowledge terms without generative AI.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.wikipedia.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open learning panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "transcript-utils.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
