rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 協作待辦清單：允許所有已登入 (Google Auth) 的使用者讀取與建立/修改清單
    match /lists/{listId} {
      allow read, write: if request.auth != null;
      
      // 待辦事項子集合：允許已登入的使用者讀取與操作
      match /todos/{todoId} {
        allow read, write: if request.auth != null;
      }
    }
    
  }
}
